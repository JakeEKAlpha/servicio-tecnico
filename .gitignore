# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — se ignoran todos SALVO la plantilla de ejemplo
.env
.env*.local
.env.development
.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editores / SO
.vscode/
.idea/
.obsidian/

# Claude Code / tooling: plugins y skills instalados (no son código del proyecto).
# `the-architect/` y `whatsapp-agentkit/` traen su propio .git anidado.
/.claude/
/.agents/
/the-architect/
/whatsapp-agentkit/
skills-lock.json

.vercel
.env*

# Cache local del CLI de Supabase (supabase db pull / migration list) - no
# es parte del esquema versionado, solo credenciales/estado de la sesion.
supabase/.temp/
