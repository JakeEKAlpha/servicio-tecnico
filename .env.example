# ─────────────────────────────────────────────────────────────
#  Servicio Técnico · Alpha Digital — variables de entorno
#  Copia este archivo como .env.local y rellena los valores.
#  NUNCA subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# Supabase — proyecto (Settings ▸ API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...

# Google Cloud — cuenta de servicio para generar los Docs/PDF de la orden.
# Es el JSON de la llave de la service account, codificado en base64.
#   base64 -w0 llave.json   (Linux)   |   [Convert]::ToBase64String(...)  (PowerShell)
GOOGLE_SERVICE_ACCOUNT_KEY_B64=

# Usuario de Google Workspace que la service account suplanta (domain-wide delegation)
GOOGLE_IMPERSONATE_USER=coordinacion@alphadigital.com.mx

# ID del Google Doc que se usa como plantilla de la orden de servicio
GOOGLE_DOC_TEMPLATE_ID=

# Push notifications (Web Push / PWA). Generar UNA vez con:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY viaja al navegador (por eso es pública);
# VAPID_PRIVATE_KEY nunca sale del servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:coordinacion@alphadigital.com.mx

# Necesita un valor real (SUPABASE_SERVICE_ROLE_KEY del dashboard ▸ Settings ▸
# API) — el endpoint del cron corre sin sesión de usuario, así que se salta
# RLS con esta clave para poder revisar todas las zonas.
SUPABASE_SERVICE_ROLE_KEY=

# Token compartido para autenticar al cron externo (cron-job.org) que llama
# a /api/cron/revisar-notificaciones cada 15 min. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
